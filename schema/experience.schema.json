{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Interview 面经 (interview report)",
  "description": "bank/experiences/<company>/<YYYY-MM>-<role>-<name>.yml. Editor hints only; tools/build.py is the source of truth.",
  "type": "object",
  "required": ["company", "role", "date", "rounds"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "company": { "type": "string", "description": "Slug from bank/tags.yml companies" },
    "role": { "type": "string", "description": "Slug from bank/tags.yml roles" },
    "level": { "enum": ["intern", "campus", "junior", "mid", "senior", "staff"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "department": { "type": "string" },
    "location": { "type": "string" },
    "result": { "enum": ["offer", "rejected", "pending", "unknown", "withdrawn"] },
    "lang": { "enum": ["zh", "en"] },
    "summary": { "type": "string" },
    "notes": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "commit": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "examples": ["一面", "二面", "HR 面", "Phone screen", "Onsite 1"] },
          "type": { "enum": ["technical", "coding", "system-design", "behavioral", "project", "hr"] },
          "duration": { "type": "integer", "description": "Minutes" },
          "notes": { "type": "string" },
          "questions": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["q"],
                  "additionalProperties": false,
                  "properties": {
                    "q": { "type": "string" },
                    "type": { "enum": ["technical", "coding", "system-design", "behavioral", "project", "hr"] },
                    "topics": { "type": "array", "items": { "type": "string" } },
                    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "followups": { "type": "array", "items": { "type": "string" } },
                    "key_points": { "type": "array", "items": { "type": "string" } },
                    "notes": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
